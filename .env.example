# EdgeDash secrets — copy this file to .env and fill in your values.
# .env is gitignored. Never commit real keys.

# Required when llm_provider = "gemini"
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Rule 47 + 48 — hosted Postgres database URL for production deployment.
# If set, overrides db_path in config.yaml. (SQLite file is used when unset
# for local dev / tests.)
# Example for Supabase / any hosted Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Add future source API keys here as new sources are registered, e.g.:
# APIFY_API_KEY=
# RAPIDAPI_KEY=
